# CuentaLuz Chile. Copiar a .env; nunca subir credenciales al repositorio.
# development: catálogo histórico visible con advertencia.
# production: bloquea el catálogo no aprobado; habilita escenarios con precios propios.
APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
PORT=8018
# Railway/Docker: APP_ENV=production, PORT asignado por la plataforma.
# ALLOWED_HOSTS=cuentaluz.tudominio.cl,tuservicio.up.railway.app,localhost,127.0.0.1
# SQLite requiere volumen persistente. PostgreSQL requiere respaldo del proveedor.
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/cuentaluz
# No se ejecutan scrapers ni envíos de correo desde el proceso web.
